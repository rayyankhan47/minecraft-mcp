# Copy to backend/.env and fill in. backend/.env is gitignored.
#
#   cp backend/.env.example backend/.env
#
# Without a key the backend still works — it serves the hardcoded mock build — so you
# can develop and demo the whole pipeline before the key arrives.

ANTHROPIC_API_KEY=

# Optional overrides.
# MCMCP_MODEL=claude-haiku-4-5
# MCMCP_MAX_TOKENS=8000
# MCMCP_FIRST_TOKEN_TIMEOUT=12
